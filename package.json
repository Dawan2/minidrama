{
  "name": "minidrama",
  "private": true,
  "version": "0.0.0",
  "description": "TikTok Minis mini-drama app — monorepo root",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "build": "pnpm -r run build",
    "gen:minis-config": "pnpm --filter @minidrama/config run gen:minis-config",
    "check:guardrails": "pnpm --filter @minidrama/app run check:guardrails",
    "check:licenses": "pnpm --filter @minidrama/quality run check:licenses",
    "check:coverage": "pnpm --filter @minidrama/quality run check:coverage",
    "check:migrate": "pnpm --filter @minidrama/server run check:migrate",
    "check:integration": "pnpm --filter @minidrama/server run check:integration",
    "check:artifact": "pnpm --filter @minidrama/app run check:artifact",
    "check:sast": "pnpm --filter @minidrama/quality run check:sast",
    "check:codeql": "pnpm --filter @minidrama/quality run check:codeql",
    "check:sca": "pnpm --filter @minidrama/quality run check:sca",
    "check:smoke": "pnpm --filter @minidrama/quality run check:smoke",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run check:coverage && pnpm run build && pnpm run check:guardrails"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.2"
  }
}
