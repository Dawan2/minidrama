{
  "name": "@minidrama/quality",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --noEmit",
    "check:licenses": "tsx src/cli/check-licenses.ts",
    "check:coverage": "tsx src/cli/check-coverage.ts",
    "check:sast": "tsx src/cli/check-sast.ts",
    "check:codeql": "tsx src/cli/check-codeql.ts",
    "check:sca": "tsx src/cli/check-sca.ts",
    "check:smoke": "tsx src/cli/check-smoke.ts",
    "check:secrets": "tsx src/cli/check-secrets.ts",
    "check:contract": "tsx src/cli/check-contract.ts",
    "check:commits": "tsx src/cli/check-commits.ts",
    "check:skips": "tsx src/cli/check-skips.ts",
    "check:audit": "tsx src/cli/check-audit.ts",
    "check:a11y": "tsx src/cli/check-a11y.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.9",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.13.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
